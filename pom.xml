<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>

    <modules>
        <module>common-library</module>
        <module>auth-service</module>
        <module>security-library</module>
        <module>transaction-service</module>
        <module>config-service</module>
        <module>registry-service</module>
        <module>gateway-service</module>
        <module>account-starter</module>
        <module>account-business-service</module>
        <module>account-personal-service</module>
        <module>info-personal-service</module>
        <module>info-business-service</module>
        <module>users-service</module>
        <module>payment-service</module>
        <module>feign-starter</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath />
    </parent>

    <groupId>ru.pshiblo</groupId>
    <artifactId>apelsin-pay</artifactId>
    <version>1.0</version>
    <name>apelsin-pay</name>
    <description>apelsin-pay</description>

    <properties>
        <spring-cloud.version>2021.0.9</spring-cloud.version>
        <java.version>11</java.version>
        <maven.compiler.release>11</maven.compiler.release>
        <!-- Spring Authorization Server 0.4.x is built against Spring Security 5.8 (Boot 2.7 manages 5.7) -->
        <spring-security.version>5.8.16</spring-security.version>
        <nimbus-jose-jwt.version>9.24.4</nimbus-jose-jwt.version>
        <spring-authorization-server.version>0.4.5</spring-authorization-server.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-oauth2-authorization-server</artifactId>
                <version>${spring-authorization-server.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
